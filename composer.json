{
  "name": "besnovatyj/yii2-cms-user",
  "description": "Модуль пользователей, аутентификации и RBAC для Yii2 CMS (User/Identity, кабинет, вход/регистрация/сброс пароля, менеджер ролей и правил).",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "extra": {
    "moduleClass": "Besnovatyj\\User\\Module",
    "moduleId": "User",
    "bescms": { "kind": "module" },
    "config-plugin": {
      "admin-menu": "src/config/adminMenu.php",
      "common": "src/config/common.php",
      "app-backend": "src/config/backend.php",
      "app-frontend": "src/config/frontend.php",
      "app-rest": "src/config/rest.php"
    }
  },
  "keywords": [
    "yii2",
    "user",
    "auth",
    "rbac",
    "oauth2",
    "cms"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "fxp-asset": {
      "enabled": false
    }
  },
  "require": {
    "besnovatyj/yii2-cms-kernel": "^1.0",
    "besnovatyj/yii2-cms-contracts": "^3.0",
    "besnovatyj/yii2-cms-helpers": "^1.0",
    "besnovatyj/yii2-cms-backend-widgets": "^1.0",
    "besnovatyj/yii2-cms-forms": "^1.0",
    "besnovatyj/yii2-cms-smart-domain-events": "^1.0",
    "besnovatyj/yii2-cms-altcha-widget": "^1.0",
    "besnovatyj/yii2-cms-datetime-widgets": "^1.0",
    "besnovatyj/yii2-cms-oauth2": "^1.0",
    "besnovatyj/yii2-cms-upload": "^1.0",
    "php": ">=8.4",
    "ext-mbstring": "*",
    "yiisoft/yii2": "~2.0.0",
    "yiisoft/yii2-bootstrap5": "~2.0.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\User\\": "src/"
    }
  }
}
